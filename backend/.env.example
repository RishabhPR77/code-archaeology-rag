# ── Required secrets ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts users' LLM API keys at rest. Changing it makes saved keys unreadable.
ENCRYPTION_KEY=

# ── App ────────────────────────────────────────────────────────────
# "production" turns on Secure cookies and hides /api/docs
ENVIRONMENT=development
# Public URL of the React app. OAuth redirects come back here.
FRONTEND_URL=http://localhost:5173
# Default: SQLite at backend/data/app.db. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/code_archaeologist

# ── Server-owned infrastructure ───────────────────────────────────
# Leave empty to use the local file-backed vector store (fine for development)
PINECONE_API_KEY=
PINECONE_INDEX=code-archaeologist
# Raises the GitHub API limit for PR fetching
GITHUB_TOKEN=
# "local" = BGE-small in-process (needs requirements-local.txt, ~550 MB RAM)
# "pinecone" = Pinecone's hosted embeddings (needs PINECONE_API_KEY; fits 512 MB hosts)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=llama-text-embed-v2

# ── Continue with GitHub (optional) ───────────────────────────────
# A GitHub App (not an OAuth App): sign-in plus read-only access to the repos users pick.
# See README → "Sign-in options". Callback URL: {FRONTEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, from https://github.com/apps/<slug>
GITHUB_APP_SLUG=

# ── Continue with Google (optional) ───────────────────────────────
# Redirect URI: {FRONTEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sign-up email codes ───────────────────────────────────────────
# off = no verification, console = codes printed in the server log (development),
# brevo = sent with Brevo's free API (needs the two values below)
EMAIL_DELIVERY=off
BREVO_API_KEY=
# A sender address you verified in Brevo
EMAIL_FROM=

# Contact address shown on the /privacy and /terms pages
CONTACT_EMAIL=

# ── Limits ─────────────────────────────────────────────────────────
# Comma-separated emails that skip all limits
ADMIN_EMAILS=
MAX_COMMITS=100
MAX_REPOS_PER_USER=5
MAX_INGESTS_PER_DAY=5
# 0 keeps repositories forever
REPO_TTL_HOURS=72
MAX_CONCURRENT_INGESTS=2

# Rotating a key: move the old value here (comma-separated for several) and set a new one above.
# Sessions, emailed codes and stored secrets made with the old key keep working; stored secrets are
# re-encrypted with the new ENCRYPTION_KEY on start-up, after which the old one can be removed.
SECRET_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS=

# Behind a proxy or CDN: the header it sets with the visitor's real address (Render: true-client-ip).
# Rate limits use it. X-Forwarded-For is never trusted, because visitors can write into it.
CLIENT_IP_HEADER=
