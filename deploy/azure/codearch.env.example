# Settings for the Azure copy. Copy this file to codearch.env ON THE VM (never commit it) and fill it in:
#   cp codearch.env.example codearch.env && chmod 600 codearch.env && nano codearch.env
# Most values are the same as on Render: open the Render dashboard -> code-archaeologist -> Environment.

# Must be the SAME as on Render: the copied database holds API keys and GitHub tokens encrypted with
# ENCRYPTION_KEY, and email codes signed with SECRET_KEY.
SECRET_KEY=
ENCRYPTION_KEY=

# The NEW Neon project in Singapore (step 2 of README.md), not Render's database
DATABASE_URL=

# This copy's own address, with https:// and no trailing slash
FRONTEND_URL=https://codearch.example.duckdns.org

# Same as on Render
PINECONE_API_KEY=
PINECONE_INDEX=code-archaeologist-llama
EMBEDDING_PROVIDER=pinecone
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_DELIVERY=brevo
BREVO_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
ADMIN_EMAILS=

# Optional: copy any limits you changed on Render (MAX_COMMITS, MAX_REPOS_PER_USER, MAX_INGESTS_PER_DAY, REPO_TTL_HOURS)
